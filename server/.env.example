# Environment Configuration for Project Management Backend

# Server port
PORT=5000

# Client origin for CORS (e.g., http://localhost:5173 for local Vite dev server)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local Docker / PostgreSQL: postgresql://postgres:postgres@localhost:5432/project_management?schema=public
# Example for Supabase / Neon: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/project_management?schema=public

# JSON Web Token Secret for authentication (minimum 32 characters in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Node environment
NODE_ENV=development
